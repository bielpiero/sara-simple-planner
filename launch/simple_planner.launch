<launch>

  <!--
    Current localisation output.
    Change to /localization/inc_ukf later if you rename the UKF output topic.
  -->
  <arg name="pose_topic" default="/pose/filtered/ukf/incremental"/>
  <arg name="cmd_vel_topic" default="/cmd_vel"/>

  <node pkg="sara_simple_planner"
        type="simple-planner.py"
        name="simple_planner"
        output="screen">

    <rosparam command="load"
              file="$(find sara_simple_planner)/config/waypoints.yaml"/>

    <param name="pose_topic" value="$(arg pose_topic)"/>
    <param name="cmd_vel_topic" value="$(arg cmd_vel_topic)"/>

    <!-- Experimental route -->
    <param name="loops" value="5"/>

    <!-- Safety: false means the chair never moves just by launching the node. -->
    <param name="auto_start" value="false"/>

    <!-- Set true during manually measured ground-truth experiments. -->
    <param name="manual_checkpoint" value="false"/>
    <param name="dwell_time" value="2.0"/>

    <!-- PD controller -->
    <param name="kp_linear" value="0.45"/>
    <param name="td_linear" value="0.08"/>
    <param name="kp_angular" value="1.00"/>
    <param name="td_angular" value="0.06"/>

    <param name="position_tolerance" value="0.03"/>
    <param name="approach_distance" value="0.30"/>
    <param name="heading_tolerance" value="0.08"/>

    <param name="max_linear_velocity" value="0.66"/>
    <param name="max_angular_velocity" value="1.10"/>

    <param name="min_effective_linear_velocity" value="0.4"/>
    <param name="min_effective_angular_velocity" value="0.6"/>

    <param name="acceleration_distance" value="0.50"/>
    <param name="deceleration_distance" value="0.15"/>

    <!-- If heading error is larger than this, rotate before advancing. -->
    <param name="rotate_in_place_threshold" value="0.2"/>

    <param name="control_hz" value="20.0"/>
    <param name="pose_timeout" value="0.50"/>

    <param name="checkpoint_topic"
           value="/simple_planner/checkpoint_reached"/>

    <param name="target_topic"
           value="/simple_planner/target_pose"/>

    <param name="log_path"
           value="/tmp/simple_planner_events.csv"/>

  </node>

</launch>
