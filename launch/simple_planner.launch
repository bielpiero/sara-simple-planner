<launch>

  <arg name="pose_topic" default="/pose/raw"/>
  <arg name="cmd_vel_topic" default="/cmd_vel"/>

  <node pkg="sara_simple_planner"
        type="simple-planner.py"
        name="simple_planner"
        output="screen">

    <!-- Waypoints -->
    <rosparam command="load"
              file="$(find sara_simple_planner)/config/waypoints.yaml"/>

    <!-- Topics -->
    <param name="pose_topic" value="$(arg pose_topic)"/>
    <param name="cmd_vel_topic" value="$(arg cmd_vel_topic)"/>

    <!-- Experiment -->
    <param name="manual_checkpoint" value="false"/>
    <param name="dwell_time" value="2.0"/>

    <!-- PD controller -->
    <param name="kp_linear" value="0.50"/>
    <param name="td_linear" value="0.04"/>

    <param name="kp_angular" value="1.00"/>
    <param name="td_angular" value="0.05"/>

    <!-- Tolerances -->
    <param name="position_tolerance" value="0.03"/>
    <param name="heading_tolerance" value="0.12"/>

    <!-- Physical velocity limits -->
    <param name="min_linear_velocity" value="0.40"/>
    <param name="max_linear_velocity" value="0.66"/>

    <param name="min_angular_velocity" value="0.60"/>
    <param name="max_angular_velocity" value="1.10"/>

    <!-- Control -->
    <param name="control_hz" value="20.0"/>
    <param name="pose_timeout" value="0.50"/>

    <!-- Logging / experiment topics -->
    <param name="checkpoint_topic"
           value="/simple_planner/checkpoint_reached"/>

    <param name="target_topic"
           value="/simple_planner/target_pose"/>

    <param name="log_path"
           value="/tmp/simple_planner_events.csv"/>

  </node>

</launch>